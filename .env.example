# Copy to .env in each service directory as needed. Never commit real secrets.

# --- MySQL (primary persistence) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jalloop
MYSQL_USER=jalloop
MYSQL_PASSWORD=change-me

# --- Spring Boot ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=8000

# Use this profile when MySQL credentials are not available:
# SPRING_PROFILES_ACTIVE=local-h2

# --- FastAPI analysis service ---
AI_SERVICE_PORT=8001
# Optional model for Strands Agents SDK (not required for core workflows)
OPENAI_API_KEY=
STRANDS_MODEL_ID=gpt-4o-mini
# Set to 1 to force the deterministic explainer even if a key is present
JALLOOP_FORCE_DETERMINISTIC_AGENT=0

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_DEMO_BANNER=true
